final height = 100; 0
final width = 10000; 1
final maxIter = 1000; 2
for y in [0..height - 1] 3 { 4
    final cy = (y - height/2.0) * 4.0 / height; 5
    for x in [0..width - 1] 6 { 7
        var zx = 0; 8
        var zy = 0; 9
        final cx = (x - width/2.0) * 4.0 / width; 10
        var i = 0; 11
        while zx*zx + zy*zy < 4.0 and i < maxIter 12 { 13
            final tmp = zx*zx - zy*zy + cx; 14 
            zy = 2.0*zx*zy + cy; 15
            zx = tmp; 16
            i = i + 1;  17
        }
    }
    print y; 18
}